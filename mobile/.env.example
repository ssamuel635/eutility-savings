# Copy to .env and restart `npx expo start`.
#
# Where the app sends customer records (sign-ups, savings checks, bills,
# switch requests). It's the computer running `npm start` in the website
# folder — use its Wi-Fi address so a phone on the same network can reach it.
# Leave it unset on a phone and the app keeps everything on the device.
# The web preview uses http://localhost:5173 when this is unset.
EXPO_PUBLIC_CRM_URL=http://192.168.1.20:5173
